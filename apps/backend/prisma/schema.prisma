generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MODERATOR
  VIEWER
}

enum RoomType {
  MAIN
  BREAKOUT
}

enum RoomStatus {
  SCHEDULED
  LIVE
  ENDED
}

enum RecordingStatus {
  STARTING
  ACTIVE
  ENDING
  READY
  FAILED
}

enum PollStatus {
  DRAFT
  OPEN
  CLOSED
}

enum PresentationStatus {
  UPLOADED
  CONVERTING
  READY
  FAILED
}

model User {
  id           String   @id @default(cuid())
  keycloakId   String   @unique
  email        String   @unique
  name         String
  role         Role     @default(VIEWER)
  // Désactivation par un admin (auth.controller.ts refuse le callback OAuth, et
  // toute session Redis déjà ouverte est révoquée immédiatement — voir
  // UsersService.setActive) — jamais un hard delete tant que l'utilisateur a des
  // salles créées (contrainte FK sur Room.creatorId).
  active       Boolean  @default(true)
  createdRooms Room[]
  enrollments  Enrollment[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Room {
  id                    String     @id @default(cuid())
  roomName              String     @unique
  title                 String
  type                  RoomType   @default(MAIN)
  parentRoomId          String?
  parentRoom            Room?      @relation("Breakouts", fields: [parentRoomId], references: [id], onDelete: Cascade)
  breakoutRooms         Room[]     @relation("Breakouts")
  // Uniquement rempli sur une Room de type BREAKOUT : userIds affectés à ce groupe
  // (un utilisateur ne peut appartenir qu'à un seul groupe à la fois par salle mère).
  assignedUserIds       String[]   @default([])
  creatorId             String
  creator               User       @relation(fields: [creatorId], references: [id])
  status                RoomStatus @default(SCHEDULED)
  startedAt             DateTime?
  endedAt               DateTime?
  currentPresentationId String?
  // Le tableau blanc est une session partagée : ouvert/fermé pour tout le monde
  // à la fois (pas un état d'affichage local par participant).
  whiteboardOpen        Boolean    @default(false)
  // Rempli uniquement pour une Room créée depuis le plugin Moodle (mod_webinairev2) —
  // moodleMeetingId identifie l'instance d'activité de façon unique et sert de clé
  // d'idempotence (POST /moodle/rooms ne doit jamais créer deux Room pour la même
  // activité rappelée plusieurs fois).
  moodleCourseId        String?
  moodleMeetingId        String?    @unique
  recordings            Recording[]
  polls                 Poll[]
  presentations         Presentation[]
  whiteboardSnapshot    WhiteboardSnapshot?
  attendanceRecords     AttendanceRecord[]
  enrollments           Enrollment[]
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([parentRoomId])
  @@map("rooms")
}

// Inscription d'un utilisateur à un cours (Room de type MAIN). Un VIEWER inscrit
// ne voit/rejoint que ce cours (voir RoomsService.list/join) ; un MODERATOR
// inscrit sur le cours d'un autre modérateur devient co-modérateur, avec les
// mêmes privilèges que le créateur (voir EnrollmentsService.canManageRoom,
// seul point de vérité pour cette règle, réutilisé par RoomAccessGuard).
// Les salles liées à Moodle (moodleMeetingId non nul) sont exemptées de cette
// restriction pour ne pas casser l'intégration existante (le plugin Moodle
// n'appelle actuellement aucun endpoint d'inscription) — ce modèle reste
// néanmoins prêt à accueillir une synchronisation Moodle future sans migration
// supplémentaire.
model Enrollment {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy String
  createdAt DateTime @default(now())

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@map("enrollments")
}

model Recording {
  id        String          @id @default(cuid())
  roomId    String
  room      Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  s3Key     String          @default("")
  s3Bucket  String          @default("")
  filename  String          @default("")
  duration  Int?
  size      BigInt?
  egressId  String?
  status    RecordingStatus @default(STARTING)
  startedAt DateTime?
  createdAt DateTime        @default(now())

  @@index([roomId])
  @@map("recordings")
}

model Poll {
  id        String       @id @default(cuid())
  roomId    String
  room      Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  question  String
  status    PollStatus   @default(DRAFT)
  multiple  Boolean      @default(false)
  createdBy String
  options   PollOption[]
  createdAt DateTime     @default(now())
  closedAt  DateTime?

  @@index([roomId])
  @@map("polls")
}

model PollOption {
  id        String         @id @default(cuid())
  pollId    String
  poll      Poll           @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label     String
  responses PollResponse[]

  @@map("poll_options")
}

model PollResponse {
  id           String     @id @default(cuid())
  pollOptionId String
  pollOption   PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  identity     String
  createdAt    DateTime   @default(now())

  @@unique([pollOptionId, identity])
  @@map("poll_responses")
}

model Presentation {
  id                String              @id @default(cuid())
  roomId            String
  room              Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  filename          String
  status            PresentationStatus  @default(UPLOADED)
  slideCount        Int                 @default(0)
  currentSlideIndex Int                 @default(0)
  slides            PresentationSlide[]
  uploadedBy        String
  createdAt         DateTime            @default(now())

  @@index([roomId])
  @@map("presentations")
}

model PresentationSlide {
  id             String       @id @default(cuid())
  presentationId String
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  index          Int
  s3Key          String
  width          Int?
  height         Int?

  @@unique([presentationId, index])
  @@map("presentation_slides")
}

// Une ligne par connexion LiveKit réelle (participant_joined/participant_left,
// voir LiveKitWebhookController) — pas une ligne par utilisateur : une même
// personne qui se reconnecte (rafraîchissement, coupure réseau) génère plusieurs
// lignes, sommées côté AttendanceService pour le temps de présence total. leftAt
// à null tant que le webhook participant_left correspondant n'est pas arrivé.
model AttendanceRecord {
  id          String    @id @default(cuid())
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  identity    String
  name        String
  isModerator Boolean   @default(false)
  joinedAt    DateTime
  leftAt      DateTime?
  // Horodatage Room.startedAt au moment de la connexion — une Room est réutilisable
  // (voir RoomsService.join : redémarrer une salle ENDED la repasse SCHEDULED puis
  // LIVE), donc roomId seul ne distingue pas deux sessions successives. La liste de
  // présence (AttendanceService.list) ne montre que les lignes dont sessionStartedAt
  // correspond au startedAt courant de la Room, pour ne jamais mélanger la présence
  // de plusieurs réunions distinctes tenues dans la même salle.
  sessionStartedAt DateTime

  @@index([roomId])
  @@index([roomId, identity])
  @@index([roomId, sessionStartedAt])
  @@map("attendance_records")
}

model WhiteboardSnapshot {
  roomId    String   @id
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sceneData Json
  updatedAt DateTime @updatedAt

  @@map("whiteboard_snapshots")
}
