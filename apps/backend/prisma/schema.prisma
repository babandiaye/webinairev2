generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MODERATOR
  VIEWER
}

enum RoomType {
  MAIN
  BREAKOUT
}

enum RoomStatus {
  SCHEDULED
  LIVE
  ENDED
}

enum RecordingStatus {
  STARTING
  ACTIVE
  ENDING
  READY
  FAILED
}

enum PollStatus {
  DRAFT
  OPEN
  CLOSED
}

enum PresentationStatus {
  UPLOADED
  CONVERTING
  READY
  FAILED
}

model User {
  id           String   @id @default(cuid())
  keycloakId   String   @unique
  email        String   @unique
  name         String
  role         Role     @default(VIEWER)
  // Désactivation par un admin (auth.controller.ts refuse le callback OAuth, et
  // toute session Redis déjà ouverte est révoquée immédiatement — voir
  // UsersService.setActive) — jamais un hard delete tant que l'utilisateur a des
  // salles créées (contrainte FK sur Room.creatorId).
  active       Boolean  @default(true)
  createdRooms Room[]
  enrollments  Enrollment[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Room {
  id                    String     @id @default(cuid())
  roomName              String     @unique
  title                 String
  type                  RoomType   @default(MAIN)
  parentRoomId          String?
  parentRoom            Room?      @relation("Breakouts", fields: [parentRoomId], references: [id], onDelete: Cascade)
  breakoutRooms         Room[]     @relation("Breakouts")
  // Uniquement rempli sur une Room de type BREAKOUT : userIds affectés à ce groupe
  // (un utilisateur ne peut appartenir qu'à un seul groupe à la fois par salle mère).
  assignedUserIds       String[]   @default([])
  creatorId             String
  creator               User       @relation(fields: [creatorId], references: [id])
  status                RoomStatus @default(SCHEDULED)
  startedAt             DateTime?
  endedAt               DateTime?
  currentPresentationId String?
  // Le tableau blanc est une session partagée : ouvert/fermé pour tout le monde
  // à la fois (pas un état d'affichage local par participant).
  whiteboardOpen        Boolean    @default(false)
  // Réglages "Session" (panneau Paramètres, visible seulement de l'animateur) —
  // par défaut true (verrouillé) pour préserver le comportement actuel : micro
  // accordé individuellement, caméra jamais accordée aux participants tant que
  // l'animateur ne déverrouille pas explicitement (voir LiveKitTokenService.
  // createRoomToken et RoomsService.updateSettings).
  micLocked              Boolean    @default(true)
  cameraLocked           Boolean    @default(true)
  // Verrous d'interaction, par défaut FALSE (rien de verrouillé) : contrairement
  // à micLocked/cameraLocked, ce ne sont pas le comportement normal d'un cours
  // mais des mesures ponctuelles (examen, chat qui déborde). Ils ne se traduisent
  // par aucune permission LiveKit — le SFU ne sait pas filtrer un canal de
  // données par sujet — et sont donc appliqués côté client, poussés en direct via
  // les métadonnées de la salle LiveKit (voir RoomsService.syncRoomMetadata).
  chatLocked             Boolean    @default(false)
  reactionsLocked        Boolean    @default(false)
  participantListLocked  Boolean    @default(false)
  // Rempli uniquement pour une Room créée depuis le plugin Moodle (mod_webinairev2).
  //
  // MÉTADONNÉES DE PROVENANCE UNIQUEMENT — jamais une clé de réutilisation, et
  // surtout pas @unique. moodleMeetingId est l'id de la ligne `webinairev2`, qui
  // n'est unique qu'au sein d'UN Moodle : ce backend étant partagé par plusieurs
  // plateformes, l'activité n°1 de disi-dev et l'activité n°1 d'un autre Moodle
  // portent le même identifiant. Chercher une salle existante par ce champ les
  // rattachait à la même Room. livestreamv3 a vécu exactement cet incident le
  // 27/07/2026 (« TEST Integration DISIDEV » rattachée à « Introduction au
  // droit ») et a retiré la contrainte pour la même raison.
  // L'idempotence est garantie CÔTÉ PLUGIN : createRoom n'est appelé qu'à la
  // création de l'activité (webinairev2_add_instance), jamais à l'affichage.
  moodleCourseId        String?
  moodleMeetingId       String?
  // URL de la page d'activité Moodle d'origine, transmise serveur-à-serveur par
  // le plugin (jamais par la barre d'adresse) : c'est là que la salle renvoie
  // l'utilisateur en fin de séance. Chaque salle porte celle de SA plateforme,
  // ce qui règle le retour pour N Moodle sans aucune liste blanche à configurer.
  moodleReturnUrl       String?
  recordings            Recording[]
  polls                 Poll[]
  presentations         Presentation[]
  whiteboardSnapshot    WhiteboardSnapshot?
  attendanceRecords     AttendanceRecord[]
  enrollments           Enrollment[]
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([parentRoomId])
  // Index simple, jamais unique (voir moodleMeetingId ci-dessus) : sert au
  // diagnostic « quelle salle vient de quelle activité », pas à la réutilisation.
  @@index([moodleMeetingId])
  @@map("rooms")
}

// Inscription d'un utilisateur à un cours (Room de type MAIN). Un VIEWER inscrit
// ne voit/rejoint que ce cours (voir RoomsService.list/join) ; un MODERATOR
// inscrit sur le cours d'un autre modérateur devient co-modérateur, avec les
// mêmes privilèges que le créateur (voir EnrollmentsService.canManageRoom,
// seul point de vérité pour cette règle, réutilisé par RoomAccessGuard).
// S'applique aussi aux salles liées à Moodle : MoodleService.syncUser inscrit
// automatiquement l'étudiant/enseignant Moodle (createdBy="moodle-sync") à
// chaque affichage de l'activité côté plugin, avant qu'il n'atteigne webinairev2.
model Enrollment {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy String
  createdAt DateTime @default(now())

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@map("enrollments")
}

model Recording {
  id        String          @id @default(cuid())
  roomId    String
  room      Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  s3Key     String          @default("")
  s3Bucket  String          @default("")
  filename  String          @default("")
  duration  Int?
  size      BigInt?
  egressId  String?
  status    RecordingStatus @default(STARTING)
  startedAt DateTime?
  createdAt DateTime        @default(now())

  @@index([roomId])
  @@map("recordings")
}

model Poll {
  id        String       @id @default(cuid())
  roomId    String
  room      Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  question  String
  status    PollStatus   @default(DRAFT)
  multiple  Boolean      @default(false)
  createdBy String
  options   PollOption[]
  createdAt DateTime     @default(now())
  closedAt  DateTime?

  @@index([roomId])
  @@map("polls")
}

model PollOption {
  id        String         @id @default(cuid())
  pollId    String
  poll      Poll           @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label     String
  responses PollResponse[]

  @@map("poll_options")
}

model PollResponse {
  id           String     @id @default(cuid())
  pollOptionId String
  pollOption   PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  identity     String
  createdAt    DateTime   @default(now())

  @@unique([pollOptionId, identity])
  @@map("poll_responses")
}

model Presentation {
  id                String              @id @default(cuid())
  roomId            String
  room              Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  filename          String
  status            PresentationStatus  @default(UPLOADED)
  slideCount        Int                 @default(0)
  currentSlideIndex Int                 @default(0)
  slides            PresentationSlide[]
  uploadedBy        String
  createdAt         DateTime            @default(now())

  @@index([roomId])
  @@map("presentations")
}

model PresentationSlide {
  id             String       @id @default(cuid())
  presentationId String
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  index          Int
  s3Key          String
  width          Int?
  height         Int?

  @@unique([presentationId, index])
  @@map("presentation_slides")
}

// Une ligne par connexion LiveKit réelle (participant_joined/participant_left,
// voir LiveKitWebhookController) — pas une ligne par utilisateur : une même
// personne qui se reconnecte (rafraîchissement, coupure réseau) génère plusieurs
// lignes, sommées côté AttendanceService pour le temps de présence total. leftAt
// à null tant que le webhook participant_left correspondant n'est pas arrivé.
model AttendanceRecord {
  id          String    @id @default(cuid())
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  identity    String
  name        String
  isModerator Boolean   @default(false)
  joinedAt    DateTime
  leftAt      DateTime?
  // Horodatage Room.startedAt au moment de la connexion — une Room est réutilisable
  // (voir RoomsService.join : redémarrer une salle ENDED la repasse SCHEDULED puis
  // LIVE), donc roomId seul ne distingue pas deux sessions successives. La liste de
  // présence (AttendanceService.list) ne montre que les lignes dont sessionStartedAt
  // correspond au startedAt courant de la Room, pour ne jamais mélanger la présence
  // de plusieurs réunions distinctes tenues dans la même salle.
  sessionStartedAt DateTime

  @@index([roomId])
  @@index([roomId, identity])
  @@index([roomId, sessionStartedAt])
  @@map("attendance_records")
}

model WhiteboardSnapshot {
  roomId    String   @id
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sceneData Json
  updatedAt DateTime @updatedAt

  @@map("whiteboard_snapshots")
}
