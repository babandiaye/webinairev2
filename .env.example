# webinairev2 tourne nativement (systemd + nginx système), comme livestreamv3 —
# pas de conteneur pour le backend/frontend. Il réutilise l'infra déjà déployée
# dans /opt/livekit (PostgreSQL, Redis, LiveKit SFU/Egress/Ingress) + MinIO externe.
# Copier ce fichier en `.env` et renseigner les valeurs réelles (demander les secrets
# LiveKit/MinIO/Keycloak déjà utilisés par livestreamv3, ou les récupérer auprès de l'admin).

# ── PostgreSQL (conteneur livekit_postgresql, exposé sur 127.0.0.1:5432, base dédiée "webinairev2") ──
DATABASE_URL=postgresql://livekit:CHANGE_ME@127.0.0.1:5432/webinairev2

# ── Redis (conteneur livekit_redis, exposé sur 127.0.0.1:6379, db0 déjà utilisée par LiveKit → BullMQ sur db1, sessions sur db2) ──
BULLMQ_REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/1
SESSION_REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/2

# ── MinIO externe (même instance que livestreamv3, bucket dédié) ──
S3_ENDPOINT=http://10.149.2.209:9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET=CHANGE_ME
S3_REGION=us-east-1
S3_BUCKET=webinairev2

# ── LiveKit (même serveur SFU/Egress/Ingress que livestreamv3, exposé sur 127.0.0.1:7880) ──
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME
LIVEKIT_WS_URL=ws://127.0.0.1:7880
LIVEKIT_WS_URL_PUBLIC=wss://preprod-webinairertc.unchk.sn

# ── Keycloak — client CONFIDENTIEL partagé avec unchk-monitor (pas un client dédié) ──
# L'échange OAuth se fait donc côté serveur (voir auth/oidc-client.service.ts), pas côté SPA.
# Redirect URI à enregistrer dans ce client Keycloak : ${PUBLIC_URL}/api/auth/callback
KEYCLOAK_ISSUER=https://senid.unchk.sn/realms/UNCHK
KEYCLOAK_CLIENT_ID=unchk-monitor
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# ── URLs publiques (mêmes domaine, frontend à la racine, API sous /api) ──
PUBLIC_URL=https://preprod-webinairev2.unchk.sn
FRONTEND_URL=https://preprod-webinairev2.unchk.sn

# ── Secrets applicatifs dédiés (ne pas réutiliser un secret d'auth existant) ──
SESSION_SECRET=change-me-session
WEBHOOK_HMAC_SECRET=change-me-webhook
DOWNLOAD_LINK_SECRET=change-me-download

# ── Backend (proxifié par nginx système sous preprod-webinairev2.unchk.sn/api) ──
BACKEND_PORT=4010
NODE_ENV=production

# ── Frontend (build-time, servi en statique par nginx) ──
VITE_API_URL=https://preprod-webinairev2.unchk.sn/api
VITE_LIVEKIT_WS_URL=wss://preprod-webinairertc.unchk.sn
